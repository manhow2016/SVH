# SVH 服务端口
SVH_PORT=3000

# SQLite 数据库文件（相对项目根目录的文件路径，或 file: 前缀）
SVH_DATABASE_URL=file:./data/svh.db

# Workspace 根目录（相对项目根目录）
SVH_WORKSPACE_ROOT=./data/workspaces

# LLM Provider（OpenAI Compatible）
SVH_LLM_BASE_URL=http://localhost:11434/v1
SVH_LLM_API_KEY=
SVH_LLM_MODEL=deepseek-chat

# 允许的跨域来源（逗号分隔多个；Web 直连独立 API 域名时需包含 Web 域名）
SVH_CORS_ORIGIN=http://localhost:5173,http://test1.kv2ray.cc
