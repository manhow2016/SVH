{
  "name": "@svh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVH HTTP API（Fastify）：Agent / 项目 / 内容 / 资产 / 技能 / 工作流",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@svh/config": "workspace:*",
    "@svh/database": "workspace:*",
    "@svh/domain": "workspace:*",
    "@svh/skills": "workspace:*",
    "@svh/workflow": "workspace:*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
