{
  "name": "@svh/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVH \u540e\u53f0 Worker\uff1a\u6d88\u8d39\u4efb\u52a1\u961f\u5217\u3001\u6267\u884c Skill\u3001\u5bf9\u8d26\u56de\u6536\u8fc7\u671f\u79df\u7ea6",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@svh/config": "workspace:*",
    "@svh/database": "workspace:*",
    "@svh/domain": "workspace:*",
    "@svh/model": "workspace:*",
    "@svh/queue": "workspace:*",
    "@svh/realtime": "workspace:*",
    "@svh/skills": "workspace:*",
    "@svh/storage": "workspace:*",
    "@svh/workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
