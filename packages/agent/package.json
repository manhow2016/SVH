{
  "name": "@svh/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVH Creative Agent：意图分析、上下文解析、工作流规划、Prompt 编译与工具调用",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@svh/domain": "workspace:*",
    "@svh/model": "workspace:*",
    "@svh/workflow": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
