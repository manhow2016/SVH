{
  "name": "@svh/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVH 任务队列：BullMQ 资源池封装（确定性 jobId、领域层重试、进度上报、优雅关闭）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@svh/config": "workspace:*",
    "@svh/domain": "workspace:*",
    "bullmq": "^5.34.0"
  },
  "devDependencies": {
    "@svh/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
