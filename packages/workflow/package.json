{
  "name": "@svh/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVH 内置工作流定义：广告 / 短视频 / 短剧 / 数字人四套 DAG",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
